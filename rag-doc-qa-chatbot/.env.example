# Free LLM API key (Groq or Gemini). Without it, the app runs in demo mode
# and shows the most relevant document excerpts instead of a generated answer.
# Get a free key: https://console.groq.com  (or https://aistudio.google.com for Gemini)
LLM_PROVIDER=groq
LLM_API_KEY=your_key_here
# Optional: pin a specific Groq model. If left unset and the default model is
# retired, the app auto-picks a live one.
# LLM_MODEL=llama-3.1-8b-instant
